# Copiá este archivo a .env.local en el VPS y completá los valores
# NO subas este archivo al repo con valores reales

NEXTAUTH_URL=https://liga3d.appchinni.com
NEXTAUTH_SECRET=generar_con_openssl_rand_hex_32
DATABASE_URL=file:./liga3d.db

# Email (SMTP) — para envío de códigos OTP
# En Gmail: activar 2FA y generar una "Contraseña de aplicación" en myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=liga3dmetro@gmail.com
SMTP_PASS=tu_contraseña_de_aplicacion_gmail

# Galería pública — carpeta de Google Drive compartida ("Cualquiera con el enlace")
GOOGLE_DRIVE_API_KEY=tu_api_key_de_google_cloud
GOOGLE_DRIVE_GALERIA_FOLDER_ID=id_de_la_carpeta_de_drive
